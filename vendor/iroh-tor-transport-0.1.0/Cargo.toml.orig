[package]
name = "iroh-tor-transport"
version = "0.1.0"
edition = "2024"
description = "Tor hidden service transport for iroh"
license = "MIT OR Apache-2.0"
authors = ["Rüdiger Klaehn <rklaehn@protonmail.com>", "n0 team"]
repository = "https://github.com/n0-computer/iroh-tor"
keywords = ["iroh", "tor", "onion", "p2p", "networking"]

[dependencies]
torut = "0.2"
tokio = { version = "1", features = ["full"] }
iroh = { version = "1.0", features = ["unstable-custom-transports"] }
n0-error = "1.0"
bytes = "1"
iroh-base = "1.0"
n0-watcher = "1.0"
n0-future = "0.3"
noq-udp = "1.0"
tracing = "0.1"
clap = { version = "4", features = ["derive"] }
data-encoding = "2"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
sha2 = "0.10"
tokio-socks = "0.5"

[dev-dependencies]
anyhow = "1"
tokio-test = "0.4"

# Uncomment to use local iroh for debugging
# [patch."https://github.com/n0-computer/iroh"]
# iroh = { path = "../iroh/iroh" }
# iroh-base = { path = "../iroh/iroh-base" }
